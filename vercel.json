{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "server.js": {
      "includeFiles": "{index.html,app.js,jarvis.js,styles.css,empire-ui.css,jarvis.css,db/postgres-schema.sql}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/server.js"
    }
  ]
}
