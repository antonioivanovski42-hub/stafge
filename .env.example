# Copy to `.env` (git-ignored) for local use, or set these in your host's environment settings.
# Never commit real values.

# Supabase: Project Settings -> Database -> Connection string (URI)
DATABASE_URL=

# Optional: path to the Supabase CA certificate to fully verify the server certificate.
# DATABASE_SSL_CA=

# Required to complete first-time owner setup (only used while the owner account still needs setup).
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# SETUP_TOKEN=

# Optional: extra comma-separated origins allowed to make state-changing API requests (custom domains behind proxies).
# ALLOWED_ORIGINS=https://example.com
